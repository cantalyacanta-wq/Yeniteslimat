rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kuryeantalyam@gmail.com' ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Delivery requests collection
    match /delivery_requests/{requestId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Users and couriers collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Email background queue
    match /email_queue/{jobId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Fallback default
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

